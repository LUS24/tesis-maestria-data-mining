# ~/projects/my-project/.envrc
export UV_PROJECT_ENVIRONMENT=~/.uv-envs/tesis-notebooks

# Guard: skip silently if bw is not available
if ! command -v bw &>/dev/null; then
  log_error "bw not found — install the Bitwarden CLI"
  return
fi

# Guard: require an active session
if [ -z "$BW_SESSION" ]; then
  log_error "BW_SESSION not set. Run: export BW_SESSION=\$(bw unlock --raw)"
  return
fi

# Load secrets from each notes item
# source <(...) works for both KEY="quoted value" and KEY=unquoted forms
set -a
source <(bw get notes "my-project-db"  2>/dev/null)
source <(bw get notes "my-project-api" 2>/dev/null)
set +a
