## Install packages and load libraries
if (!require(here)) install.packages("here")
if (!require(tidyverse))install.packages("tidyverse")
if (!require(rstatix)) install.packages("rstatix")
if (!require(ggpubr)) install.packages("ggpubr")
if (!require(ggpubr)) install.packages("RColorBrewer")
if (!require(GGally)) install.packages("GGally")
library("here")
library("tidyverse")
library("rstatix")
library("RColorBrewer")
library("GGally")
i_am("part_i/analisis_datos.qmd")
metrics_source_data = read_csv(here("part_i", "metric_comparison_source_data_cleaned.csv"))
lista_metricas <- metrics_source_data %>%
select(metrica) %>%
unique() %>%
.$metrica
lista_metricas
selected_metric <- "jaccard_similarity"
metrics_source_data %>%
filter(metrica == "jaccard_similarity") %>%
ggplot(aes(x=id_modelo_especialista, y=valor)) +
geom_boxplot() +
facet_wrap(~estrategia) +
labs(title="Índice de Jaccard",x = "Modelos", y = "Valor métrica") +
theme_bw()
